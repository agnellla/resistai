# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/

# Data - never commit the image datasets (too big, licensing)
data/real/*
data/ai/*
!data/real/.gitkeep
!data/ai/.gitkeep

# Model weights and generated outputs
checkpoints/*.pt
checkpoints/*.pth
reports/*.png
reports/*.csv
reports/*.json
predictions.json

# OS / editor noise
.DS_Store
.idea/
.vscode/

# Dataset images - not committed. But DO commit the split manifests
# (data/splits/*.csv) so every experiment uses the identical partition.
data/cifake/
data/*.zip
!data/splits/
!data/splits/*.csv
outputs/
