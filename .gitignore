# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/

# Data - never commit the image datasets (too big, licensing)
data/real/*
data/ai/*
!data/real/.gitkeep
!data/ai/.gitkeep

# Model weights
checkpoints/*.pt
checkpoints/*.pth
predictions.json

# reports/ holds committed deliverables (analysis, benchmark CSVs, figures).
# Only ad-hoc scratch is ignored:
reports/_scratch/

# OS / editor noise
.DS_Store
.idea/
.vscode/

# Dataset images - not committed. But DO commit the split manifests
# (data/splits/*.csv, data/splits_v2/*.csv + its json) so every experiment
# uses the identical partition.
data/cifake/
data/v2_images/
data/*.zip
!data/splits/
!data/splits/*.csv
!data/splits_v2/
!data/splits_v2/*.csv
!data/splits_v2/*.json
outputs/
